# API Keys Configuration
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIzaSyXXX

# Firebase Configuration (disabled by default; set true when Firestore is ready)
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=

# Cloudflare R2 Storage Configuration (100% FREE 10GB S3 Storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=epub-translator-bucket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Model Defaults
DEFAULT_GEMINI_MODEL=gemini-1.5-flash
DEFAULT_TRANSLATION_MODEL=claude-3-7-sonnet-20250219

