# API Keys Configuration
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIzaSyXXX

# Backend auth mode. Keep local for development; production must use Supabase.
APP_ENV=development
AUTH_REQUIRED=false

# Firebase Configuration (disabled by default; set true when Firestore is ready)
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_KEY=serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=

# Blob Storage Provider ('supabase' | 'r2' | 'local')
STORAGE_PROVIDER=supabase

# Supabase Storage Configuration (100% Free Persistent Blob Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_REQUIRED=false
SUPABASE_STORAGE_BUCKET=novels
SUPABASE_STORAGE_PUBLIC_URL=

# Cloudflare R2 Storage Configuration (S3-Compatible Free 10GB Storage - kept for fallback/switching)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=epub-translator-bucket
CLOUDFLARE_R2_PUBLIC_URL=

# Model Defaults
DEFAULT_GEMINI_MODEL=gemini-1.5-flash
DEFAULT_TRANSLATION_MODEL=claude-3-7-sonnet-20250219

